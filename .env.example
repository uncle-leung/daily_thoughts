# QQ mailbox SMTP. The authorization code is not the QQ login password.
# Mailbox → Settings → Account → POP3/IMAP/SMTP → generate an authorization code.
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
# Sending mailbox. Also the SMTP login when QQ_SMTP_USER is empty.
# Several addresses are allowed, separated by commas. The first one logs in.
DIGEST_TO=
# Extra recipients. Commas, Chinese commas, or spaces. Not used to log in.
DIGEST_ALSO=

# Used only when QQ_SMTP_AUTH_CODE is empty. The first FormSubmit delivery
# asks the mailbox to confirm the address.
DIGEST_FALLBACK=formsubmit

# Cursor cloud agent for current events. Dashboard → API Keys.
# The agent must search the web. Do not commit the key.
CURSOR_API_KEY=
CURSOR_MODEL=grok-4.7
